{
  "name": "medicore-hms",
  "private": true,
  "version": "0.0.1",
  "description": "PaperlessTech HMS \u2014 enterprise multi-tenant hospital management SaaS (monorepo root)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm contract:check && pnpm client:check && pnpm test && pnpm --filter @medicore/api test:int && pnpm build && pnpm boundaries",
    "docker:dev": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "docker:dev:down": "docker compose -f infra/docker/docker-compose.yml down",
    "clean": "rm -rf apps/*/.next apps/*/.next-dev apps/*/dist packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "prepare": "husky",
    "verify": "node scripts/verify.mjs",
    "seed:operator": "pnpm --filter @medicore/api operator:ensure --",
    "seed:hospital": "pnpm --filter @medicore/api provision --",
    "seed:migrate": "pnpm --filter @medicore/api migrate --",
    "seed:demo": "pnpm --filter @medicore/api seed:demo",
    "seed:clinical": "pnpm --filter @medicore/api seed:clinical --",
    "openapi": "pnpm --filter @medicore/api openapi",
    "openapi:check": "pnpm --filter @medicore/api openapi:check",
    "contract:check": "pnpm --filter @medicore/api contract:check",
    "client:check": "pnpm --filter @medicore/api client:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "dependency-cruiser": "^16.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
