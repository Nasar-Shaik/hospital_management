{
  "name": "@medicore/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 19000",
    "eas-build-post-install": "pnpm --filter \"@medicore/mobile^...\" build",
    "android": "expo start --port 19000 --android",
    "ios": "expo start --port 19000 --ios",
    "start:tunnel": "expo start --port 19000 --tunnel",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src",
    "test": "vitest run",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo/bundle-check --no-bytecode"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@medicore/api-client": "workspace:*",
    "@medicore/permissions": "workspace:*",
    "@medicore/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@medicore/config": "workspace:*",
    "@types/react": "19.1.17",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
