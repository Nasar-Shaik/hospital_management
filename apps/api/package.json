{
  "name": "@medicore/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude '**/*.int.test.ts' --exclude '**/node_modules/**' --exclude '**/dist/**'",
    "test:int": "vitest run int.test --no-file-parallelism",
    "provision": "tsx --env-file-if-exists=.env src/scripts/provisionTenant.ts",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrateTenants.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seedDemo.ts",
    "seed:clinical": "tsx --env-file-if-exists=.env src/scripts/seedClinical.ts",
    "plan": "tsx --env-file-if-exists=.env src/scripts/setPlan.ts",
    "audit:chain": "tsx --env-file-if-exists=.env src/scripts/auditChain.ts",
    "operator": "tsx --env-file-if-exists=.env src/scripts/createOperator.ts",
    "operator:ensure": "tsx --env-file-if-exists=.env src/scripts/ensureOperator.ts",
    "routes": "tsx --env-file-if-exists=.env src/scripts/routeAudit.ts",
    "openapi": "tsx --env-file-if-exists=.env src/scripts/generateOpenapi.ts"
  },
  "dependencies": {
    "@medicore/logger": "workspace:*",
    "@medicore/permissions": "workspace:*",
    "@medicore/types": "workspace:*",
    "@medicore/validation": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.49.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "mongoose": "^8.13.0",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@medicore/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.24.0",
    "prettier": "^3.5.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
