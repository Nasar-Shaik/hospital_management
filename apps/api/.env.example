# apps/api — copy to .env for local dev. Never commit real values (Doc 09 §20).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Shared MongoDB cluster. The master DB and co-located tenant DBs are databases
# on this cluster (Doc 03 §1.1).
#
# `directConnection=true` is REQUIRED from the host: the dev replica set advertises
# its member as `localhost:27017`, so without it the driver "discovers" that address
# and connects to whatever else is on host port 27017 (see PROJECT_MEMORY §8).
# Transactions still work — we connect directly to the replica-set primary.
MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_MASTER_DB=paperlesstech_master
TENANT_DB_PREFIX=hms_
TENANT_BASE_DOMAIN=paperlesstech.in

REDIS_URL=redis://localhost:6380
TENANT_CACHE_TTL_SECONDS=300

# Connection Manager guardrails (Doc 04 §2.2.1)
TENANT_MAX_CONNECTIONS=200
TENANT_CONNECTION_IDLE_MS=600000

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
