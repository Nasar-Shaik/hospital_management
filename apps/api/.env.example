# apps/api — copy to .env for local dev. Never commit real values (Doc 09 §20).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Which interface to listen on. Leave UNSET in production: it then binds 127.0.0.1
# and is reachable only through Nginx/Traefik, so a wrong firewall rule cannot put
# Express on the public internet. Containers must set 0.0.0.0 (compose does).
# API_BIND=0.0.0.0

# Shared MongoDB cluster. The master DB and co-located tenant DBs are databases
# on this cluster (Doc 03 §1.1).
#
# `directConnection=true` is REQUIRED from the host: the dev replica set advertises
# its member as `localhost:27017`, so without it the driver "discovers" that address
# and connects to whatever else is on host port 27017 (see PROJECT_MEMORY §8).
# Transactions still work — we connect directly to the replica-set primary.
MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_MASTER_DB=paperlesstech_master
TENANT_DB_PREFIX=hms_

# The hostname IS the hospital: `<slug>.<TENANT_BASE_DOMAIN>` selects its database.
#
# In dev use `localhost`, because `<anything>.localhost` resolves to 127.0.0.1 with
# no /etc/hosts entry — so http://demo.localhost:3000 just works. Do NOT use the real
# domain locally: `demo.paperlesstech.in` has a wildcard DNS record and would send
# your browser to the production server.
#
# In production this is the real platform domain.
TENANT_BASE_DOMAIN=localhost

REDIS_URL=redis://localhost:6380
TENANT_CACHE_TTL_SECONDS=300

# Connection Manager guardrails (Doc 04 §2.2.1)
TENANT_MAX_CONNECTIONS=200
TENANT_CONNECTION_IDLE_MS=600000

# Identity & Authentication (ADR-0009). REQUIRED — the app refuses to boot without
# them, deliberately: a default signing secret is how a dev key reaches production.
#   API_JWT_SECRET:    openssl rand -base64 48
#   API_ENCRYPTION_KEY: openssl rand -base64 32   (must decode to exactly 32 bytes)
API_JWT_SECRET=change-me-openssl-rand-base64-48-at-least-32-chars
API_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
API_JWT_ISSUER=paperlesstech
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_CHALLENGE_TTL_SECONDS=300

# Password policy + brute-force lockout
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
