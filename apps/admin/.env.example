# apps/admin — the OPERATOR CONSOLE. Copy to .env for local dev.
#
# Browse http://admin.localhost:3001
#
# `admin` is a RESERVED slug (see tenant.service.ts): no hospital can ever take
# that hostname, precisely so the console cannot be hijacked by a customer.
#
# The console calls the API on the SAME hostname it is served from, on the API
# port — the same rule as the hospital app, because a browser cannot set a Host
# header. In production the gateway routes /api/* on the same origin and this is
# left empty.
NEXT_PUBLIC_API_PORT=4000

# Server-side only.
API_BASE_URL=http://localhost:4000
