# apps/web — copy to .env for local dev.

# ── HOW THE BROWSER REACHES THE API ─────────────────────────────────────────
# The hostname you browse IS the hospital (ADR-0005): a browser cannot set a
# `Host` header, so the API must be called on the SAME hostname. We therefore
# configure a PORT, not a base URL — a hardcoded http://localhost:4000 would
# resolve to no hospital at all and every request would fail with HMS-TEN-001.
#
#   dev:  demo.localhost:3000  →  demo.localhost:4000
#   prod: leave NEXT_PUBLIC_API_PORT empty — the gateway routes /api/* on the
#         same host, so the client calls the same origin.
#
# ⚠️  BROWSE http://demo.localhost:3000 — NOT localhost:3000, and NEVER
#     demo.paperlesstech.in:3000.
#
#     `*.paperlesstech.in` has WILDCARD DNS pointing at the production server
#     (103.135.230.131). Browsing it locally does not reach your laptop at all:
#     the browser leaves the machine, fails to connect, and the login screen
#     says "Could not reach the server" — which looks like a bug in the app and
#     is really a bug in the address. If production ever serves port 3000, you
#     would be logging in to the LIVE system while believing you are local.
#
#     `*.localhost` resolves to 127.0.0.1 with no /etc/hosts entry and no DNS
#     lookup at all, on every modern browser. Nothing to install, nothing to
#     leave behind, and it cannot escape your machine.
#
#     Plain `localhost:3000` names no hospital, so it fails honestly with
#     HMS-TEN-001 ("This address does not belong to any hospital").
NEXT_PUBLIC_API_PORT=4000

# Server-side only (server components, health route).
API_BASE_URL=http://localhost:4000

# ── WORKSTATION INACTIVITY LOCK ─────────────────────────────────────────────
# A signed-in screen left unattended is warned, then signed out (and the session
# is revoked server-side). This is separate from the token lifetimes in the API:
# tokens are the "keep me signed in" window; this is the "don't leave patient
# data open on an unattended ward PC" lock. Tune per deployment.
#
#   NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES  minutes of no interaction before sign-out.
#                                     Default 30. Set 0 to DISABLE the lock.
#   NEXT_PUBLIC_IDLE_WARN_SECONDS     countdown shown before it fires. Default 60.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_IDLE_WARN_SECONDS=60
