    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@medicore/config": "workspace:*",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
